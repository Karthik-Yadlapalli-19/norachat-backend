{
  "info": {
    "_postman_id": "a415116c-e7bc-47df-9f30-6fb2efb1e952",
    "name": "NoraChat Auth",
    "description": "Authentication and account endpoints for NoraChat. Start by requesting an OTP, then verify it to populate accessToken and refreshToken. Set baseUrl to the API origin and email to an address that can receive verification email.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Request OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/otp/request",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "otp",
            "request"
          ]
        },
        "description": "Sends a six-digit verification code to the supplied email address."
      },
      "response": []
    },
    {
      "name": "Verify OTP (Login or Sign Up)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OTP verification succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "  pm.collectionVariables.set('userId', data.user.id);",
              "  pm.collectionVariables.set('isNewUser', data.is_new_user);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/otp/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "otp",
            "verify"
          ]
        },
        "description": "Verifies the emailed code and returns access/refresh tokens. The test script stores the tokens and user ID for later requests. Set otpCode to the code received by email."
      },
      "response": []
    },
    {
      "name": "Get Current User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        },
        "description": "Returns the authenticated user's ID, email, and name."
      },
      "response": []
    },
    {
      "name": "Update Current User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nora User\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        },
        "description": "Updates the authenticated user's name (1-50 characters)."
      },
      "response": []
    },
    {
      "name": "Refresh Tokens",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token refresh succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "description": "Rotates the refresh token and returns a new access/refresh token pair. The test script saves both new tokens."
      },
      "response": []
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        },
        "description": "Revokes the current refresh token. Returns 204 with no response body."
      },
      "response": []
    },
    {
      "name": "Delete Current User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        },
        "description": "Permanently deletes the authenticated user's account. Returns 204 with no response body."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "you@example.com",
      "type": "string"
    },
    {
      "key": "otpCode",
      "value": "000000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "isNewUser",
      "value": "",
      "type": "string"
    }
  ]
}
